{
    "version": 3,
    "configurePresets": [
        {
            "name": "debug",
            "binaryDir": "build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "asan",
            "binaryDir": "build-asan",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CHESS_ENABLE_SANITIZERS": "ON"
            }
        },
        {
            "name": "release",
            "binaryDir": "build-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ]
}
